// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trade {
  id                String   @id @default(cuid())
  pair              String
  accountId         String?
  account           Account? @relation(fields: [accountId], references: [id])
  tradeType         String
  tradeDirection    String
  date              String
  time              String
  entryExecutionTime String?
  entryPrice        String
  stopLoss          String
  takeProfit        String
  exitPrice         String
  rrRatio           Float
  lotSize           String
  tradeDuration     String
  outcome           String
  profitLoss        String
  profitLossPercent String
  beforeTrade       String
  duringTrade       String
  afterTrade        String
  beforeScreenshot  String?
  afterScreenshot   String?
  screenshots       String? // JSON stringified array of strings
  tags              String? // JSON stringified array of tags
  followedRules     Boolean?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Account {
  id              String   @id @default(cuid())
  name            String
  type            String   // e.g. "funded", "personal", "demo"
  balance         Float
  accountSize     String   // e.g. "5k", "10k", "100k"
  brokerName      String   // e.g. "IC Markets", "Deriv"
  currency        String?  // e.g. "USD", "EUR"
  leverage        String?  // e.g. "1:100", "1:500"
  status          String   @default("active") // account status: active or suspended
  suspendedDate   String?  // date account was suspended
  suspendedReason String?  // reason for suspension
  startDate       String?  // When the account was opened
  notes           String?  // Additional notes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trades          Trade[]
  transactions    Transaction[]
}

model Goal {
  id            String   @id @default(cuid())
  title         String
  category      String   // "profit" | "consistency" | "risk" | "psychology" | "strategy"
  targetValue   Float
  currentValue  Float    @default(0)
  unit          String   @default("")   // "$", "%", "days", "trades", "R"
  timeframe     String   // "daily" | "weekly" | "monthly" | "quarterly" | "yearly" | "custom"
  startDate     String
  endDate       String
  priority      String   @default("medium") // "low" | "medium" | "high" | "critical"
  status        String   @default("active") // "active" | "completed" | "failed" | "paused"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Habit {
  id          String   @id @default(cuid())
  name        String
  category    String   // "discipline" | "analysis" | "risk" | "psychology"
  date        String   // YYYY-MM-DD
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiAnalysis {
  id               String   @id @default(cuid())
  filters          String   // JSON: { dateRange, symbol, strategy, winLoss, session, analysisTarget }
  qualityScore     String   // JSON: qualityScore object
  executiveSummary String   // JSON: executiveSummary object
  compliance       String   // JSON: compliance array
  complianceNote   String?  // optional text
  psychology       String   // JSON: psychology object
  risk             String   // JSON: risk object
  patterns         String   // JSON: patterns object
  improvementPlan  String   // JSON: improvementPlan array
  profile          String   // JSON: profile object
  insights         String   // JSON: insights array
  createdAt        DateTime @default(now())
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Transaction {
  id              String   @id @default(cuid())
  date            String   // YYYY-MM-DD
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  type            String   // "withdrawal" | "deposit" | "payout"
  amount          Float
  currency        String
  method          String   // "Bank Transfer" | "Wise" | "PayPal" | "Skrill" | "Crypto" | "Other"
  status          String   // "Pending" | "Approved" | "Completed" | "Rejected"
  notes           String?
  screenshots     String?  // JSON stringified array of URLs
  // Profit Split Fields (only for funded accounts / payouts)
  grossProfit     Float?
  propShare       Float?
  traderShare     Float?
  netReceived     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
