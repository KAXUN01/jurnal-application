// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trade {
  id                String   @id @default(cuid())
  pair              String
  accountId         String?
  account           Account? @relation(fields: [accountId], references: [id])
  tradeType         String
  tradeDirection    String
  date              String
  time              String
  entryExecutionTime String?
  entryPrice        String
  stopLoss          String
  takeProfit        String
  exitPrice         String
  rrRatio           Float
  lotSize           String
  tradeDuration     String
  outcome           String
  profitLoss        String
  profitLossPercent String
  beforeTrade       String
  duringTrade       String
  afterTrade        String
  beforeScreenshot  String?
  afterScreenshot   String?
  screenshots       String? // JSON stringified array of strings
  tags              String? // JSON stringified array of tags
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Account {
  id              String   @id @default(cuid())
  name            String
  type            String   // e.g. "funded", "personal", "demo"
  balance         Float
  accountSize     String   // e.g. "5k", "10k", "100k"
  brokerName      String   // e.g. "IC Markets", "Deriv"
  currency        String?  // e.g. "USD", "EUR"
  leverage        String?  // e.g. "1:100", "1:500"
  status          String   @default("active") // account status: active or suspended
  suspendedDate   String?  // date account was suspended
  suspendedReason String?  // reason for suspension
  startDate       String?  // When the account was opened
  notes           String?  // Additional notes
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trades          Trade[]
}
